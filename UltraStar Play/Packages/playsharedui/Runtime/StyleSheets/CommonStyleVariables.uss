:root {
    /* Singnova design tokens */
    --sn-bg: rgb(10, 10, 10);
    --sn-surface: rgb(20, 20, 20);
    --sn-surface-2: rgb(22, 22, 22);
    --sn-surface-3: rgb(28, 28, 28);
    --sn-border: rgb(26, 26, 26);
    --sn-border-2: rgb(31, 31, 31);
    --sn-border-3: rgb(42, 42, 42);
    --sn-text: rgb(245, 245, 245);
    --sn-text-2: rgb(163, 163, 163);
    --sn-text-3: rgb(115, 115, 115);
    --sn-text-4: rgb(82, 82, 82);
    --sn-accent: rgb(220, 38, 38);
    --sn-accent-hover: rgb(239, 68, 68);
    --sn-success: rgb(110, 231, 183);

    --font-color: #F0F0F0;
    --font-color-secondary: #CCCCCC;
    --font-color-inverted: rgb(64, 64, 64);
    --font-color-accent1: lightgrey;
    --font-color-error: rgb(220, 53, 69);
    --font-color-warning: rgb(255, 193, 7);
    --control-color: #475467;
    --control-color-accent1: #6A7D99;
    --control-color-accent2: #6A7D99;
    --control-danger: rgb(220, 53, 69);
    --control-danger-accent1: rgb(200, 35, 51);

    --font-size-xxs: 8px;
    --font-size-xs: 10px;
    --font-size-s: 12px;
    --font-size: 14px;
    --font-size-l: 18px;
    --font-size-xl: 20px;
    --font-size-xxl: 22px;
    --font-icon-size: 26px;
    --control-height: 30px;
    --control-height-double: 60px;
    --control-height-half: 15px;
    --control-width: 100px;
    --control-width-half: 50px;
    --control-width-large: 120px;
    --round-button-size: 40px;
    --control-height-large: 74px;
    --control-height-small: 20px;
    --radio-button-size: 20px;
    --main-scene-button-width: 150px;
    --main-scene-sing-button-width: 310px;
}