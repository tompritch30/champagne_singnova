/*
 * SingNova – Global visual language
 * Imported after CommonStyleVariables so --sn-* tokens are available.
 */

/* ── Global dark-theme overrides for Unity built-in controls ── */

.unity-button {
    background-color: var(--sn-surface);
    background-image: none;
    border-width: 1px;
    border-color: var(--sn-border-2);
    border-radius: 6px;
    color: var(--sn-text);
    padding: 7px 14px;
    font-size: 13px;
    height: auto;
    transition: background-color 120ms ease-out, border-color 120ms ease-out;
}

.unity-button:hover {
    background-color: var(--sn-surface-3);
    background-image: none;
    border-color: var(--sn-border-3);
}

.unity-button:focus {
    background-image: none;
}

.unity-base-text-field__input,
.unity-text-element--inner-input-field-component {
    background-color: var(--sn-surface-2);
    border-color: var(--sn-border-2);
    border-radius: 6px;
    color: var(--sn-text);
    font-size: 13px;
    --unity-cursor-color: var(--sn-text);
}

.unity-base-text-field__input:focus {
    border-color: var(--sn-border-3);
    border-width: 1px;
}

.unity-scroller__slider .unity-base-slider__tracker {
    background-color: var(--sn-border);
}

.unity-scroller__slider .unity-base-slider__dragger {
    background-color: var(--sn-border-3);
    border-radius: 2px;
    border-width: 0;
}

.unity-base-dropdown__container-outer {
    background-color: var(--sn-surface);
    border-color: var(--sn-border-3);
    border-radius: 6px;
    border-width: 1px;
}

/* ── Typography helpers — compound .unity-label.sn-* outspecify legacy --font-color ── */

.unity-label.sn-wordmark,
.sn-wordmark {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--sn-text);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.unity-label.sn-eyebrow,
.sn-eyebrow {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--sn-text-4);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.unity-label.sn-display,
.sn-display {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--sn-text);
    letter-spacing: -2px;
    white-space: normal;
    margin-top: 14px;
    margin-bottom: 14px;
}

.unity-label.sn-body-text,
.sn-body-text {
    font-size: 14px;
    color: var(--sn-text-2);
    white-space: normal;
}

.unity-label.sn-version,
.sn-version {
    font-size: 11px;
    color: var(--sn-text-4);
    margin: 0;
    padding: 0;
}

.unity-label.sn-page-eyebrow {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--sn-text-4);
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.unity-label.sn-page-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--sn-text);
    letter-spacing: -1px;
    margin-top: 4px;
    margin-bottom: 0;
}

/* ── Main menu screen ── */

.sn-main-screen {
    flex-grow: 1;
    background-color: var(--sn-bg);
    padding-top: 40px;
    padding-right: 48px;
    padding-bottom: 40px;
    padding-left: 48px;
    flex-direction: column;
    justify-content: space-between;
}

.sn-main-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0;
}

.sn-main-body {
    flex-direction: row;
    align-items: flex-end;
    flex-grow: 1;
    margin-top: 40px;
    margin-bottom: 40px;
}

.sn-main-left {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 60px;
    flex-direction: column;
    justify-content: flex-end;
}

.sn-main-right {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    justify-content: flex-end;
}

/* CTA cards — compound .unity-button.sn-* selectors outspecify legacy .unity-button rules */
.unity-button.sn-cta-primary,
.unity-button.sn-cta-secondary {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    padding-right: 20px;
    padding-bottom: 16px;
    padding-left: 20px;
    border-radius: 6px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    border-width: 1px;
    height: auto;
    min-height: 64px;
    -unity-font-style: normal;
    flex-shrink: 0;
}

.unity-button.sn-cta-primary {
    background-color: var(--sn-accent);
    border-color: var(--sn-accent);
}

.unity-button.sn-cta-primary:hover,
.unity-button.sn-cta-primary:focus {
    background-color: var(--sn-accent-hover);
    border-color: var(--sn-accent-hover);
}

.unity-button.sn-cta-secondary {
    background-color: var(--sn-surface);
    border-color: var(--sn-border-2);
}

.unity-button.sn-cta-secondary:hover,
.unity-button.sn-cta-secondary:focus {
    background-color: var(--sn-surface-3);
    border-color: var(--sn-border-3);
}

/* legacy rule removed — was hiding arrow Labels because ui:Label inherits .unity-text-element */

.sn-cta-text {
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.unity-label.sn-cta-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--sn-text);
    margin: 0;
    padding: 0;
}

.unity-button.sn-cta-primary .unity-label.sn-cta-title {
    color: rgb(255, 255, 255);
}

.unity-label.sn-cta-sub {
    font-size: 11px;
    color: var(--sn-text-3);
    margin-top: 2px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
}

.unity-button.sn-cta-primary .unity-label.sn-cta-sub {
    color: rgba(255, 255, 255, 0.65);
}

.unity-label.sn-cta-arrow {
    font-size: 18px;
    color: var(--sn-text-3);
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 0;
    margin-left: 12px;
    padding: 0;
}

.unity-button.sn-cta-primary .unity-label.sn-cta-arrow {
    color: rgba(255, 255, 255, 0.8);
}

/* Footer */
.sn-main-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top-width: 1px;
    border-top-color: var(--sn-border);
}

.sn-footer-links {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.unity-button.sn-footer-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--sn-text-3);
    font-size: 12px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 24px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 0;
    padding-right: 0;
    height: auto;
    min-height: 0;
    -unity-font-style: normal;
}

.unity-button.sn-footer-link:hover,
.unity-button.sn-footer-link:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--sn-text);
}

/* legacy footer-link icon-hiding rule removed — Button.text used directly now */

.unity-button.sn-version-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin: 0;
    height: auto;
    min-height: 0;
}

.unity-button.sn-version-btn:hover,
.unity-button.sn-version-btn:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* ── Song Select layout ── */

.sn-song-select-root {
    flex-direction: row;
    flex-grow: 1;
    background-color: var(--sn-bg);
    width: 100%;
    height: 100%;
}

/* Sidebar */
.sn-sidebar {
    width: 180px;
    flex-shrink: 0;
    background-color: var(--sn-bg);
    border-right-width: 1px;
    border-right-color: var(--sn-border);
    flex-direction: column;
    padding-top: 28px;
    padding-bottom: 20px;
}

.sn-sidebar-brand {
    padding-left: 22px;
    padding-right: 22px;
    margin-bottom: 36px;
    background-color: rgba(0, 0, 0, 0);
}

.sn-sidebar-section {
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(0, 0, 0, 0);
}

.sn-sidebar-section-bordered {
    margin-top: 24px;
    padding-top: 24px;
    border-top-width: 1px;
    border-top-color: var(--sn-border);
}

.sn-sidebar-heading {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--sn-text-4);
    letter-spacing: 1px;
    padding-top: 0;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.unity-button.sn-nav-item {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 6px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    flex-direction: row;
    align-items: center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 1px;
    margin-left: 0;
    justify-content: flex-start;
    height: auto;
    min-height: 0;
    -unity-font-style: normal;
}

.unity-button.sn-nav-item:hover,
.unity-button.sn-nav-item:focus {
    background-color: var(--sn-surface);
    background-image: none;
    border-color: rgba(0, 0, 0, 0);
}

.sn-nav-active {
    background-color: var(--sn-surface-2);
}

.sn-nav-label {
    font-size: 13px;
    color: var(--sn-text-2);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.sn-nav-active .sn-nav-label {
    color: var(--sn-text);
    -unity-font-style: bold;
}

.sn-nav-badge {
    font-size: 10px;
    color: var(--sn-text-3);
    background-color: var(--sn-border);
    border-radius: 9px;
    padding-top: 1px;
    padding-right: 6px;
    padding-bottom: 1px;
    padding-left: 6px;
    white-space: nowrap;
}

/* hide badge pill when no text content */
.sn-nav-badge:empty {
    display: none;
}

/* Song entry card — dark compact variant */
.sn-song-card {
    background-color: var(--sn-surface);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--sn-border-2);
}

.sn-song-card:hover {
    background-color: var(--sn-surface-3);
    border-color: var(--sn-border-3);
}

/* Song entry title/artist in dark theme */
#songTitle {
    color: var(--sn-text);
    font-size: 13px;
}

#songArtist {
    color: var(--sn-text-3);
    font-size: 11px;
}

/* Status badge on song card */
.sn-song-status-ready {
    color: var(--sn-success);
}

.sn-song-status-fetch {
    color: var(--sn-text-4);
}

/* ── Song select top bar dark ── */

#topContent {
    background-color: rgba(10, 10, 10, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: var(--sn-border);
    padding-top: 12px;
    padding-bottom: 12px;
}

#sceneTitle {
    color: var(--sn-text);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* Search field in song select */
#searchTextField {
    background-color: var(--sn-surface-2);
    border-color: var(--sn-border-2);
    border-radius: 6px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

#searchTextField .unity-base-text-field__input {
    background-color: var(--sn-surface-2);
    border-color: rgba(0, 0, 0, 0);
    color: var(--sn-text);
    font-size: 13px;
    --unity-cursor-color: var(--sn-text);
}

#searchTextField.noSearchResults {
    border-color: var(--sn-accent);
    border-width: 1px;
}

#searchPropertyButton {
    background-color: var(--sn-surface-2);
    border-color: var(--sn-border-2);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* ── Song select bottom bar ── */

#bottomContent {
    background-color: rgba(10, 10, 10, 0.92);
    border-top-width: 1px;
    border-top-color: var(--sn-border);
    padding-top: 10px;
    padding-bottom: 10px;
}

/* Difficulty chooser */
#difficultyChooser {
    background-color: var(--sn-surface-2);
    border-color: var(--sn-border-2);
    border-width: 1px;
    border-radius: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
}

#currentDifficultyLabel {
    color: var(--sn-text);
    font-size: 12px;
}

/* Sing / start button in bottom bar */
#startSongButton,
#singButton {
    background-color: var(--sn-accent);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 13px;
    border-radius: 6px;
    padding-top: 9px;
    padding-right: 22px;
    padding-bottom: 9px;
    padding-left: 22px;
}

#startSongButton:hover,
#singButton:hover {
    background-color: var(--sn-accent-hover);
}

/* Song list container — flex column, no overlap */
#songListContainer {
    background-color: rgba(0, 0, 0, 0);
}

/* Library list virtualized */
.sn-library-list {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-grow: 1;
}

.sn-library-list .unity-collection-view__item {
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    border-width: 0;
}

.sn-library-list .unity-collection-view__item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.sn-library-list .unity-collection-view__item--selected,
.sn-library-list .unity-collection-view__item:checked {
    background-color: rgba(255, 255, 255, 0.06);
}

/* Song row */
.sn-row-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.sn-song-row {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 6px;
    flex-grow: 1;
}

.sn-row-art {
    background-color: rgb(38, 38, 38);
}

.sn-row-letter {
    -unity-font-style: italic;
}

/* Top bar icons — flat monochrome */
.sn-top-icons {
    flex-direction: row-reverse;
    align-items: center;
}

.unity-button.sn-top-icon-btn,
ToggleButton.sn-top-icon-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    width: 28px;
    height: 28px;
    min-height: 0;
    min-width: 0;
    margin-left: 9px;
    margin-right: 9px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.unity-button.sn-top-icon-btn:hover,
.unity-button.sn-top-icon-btn:focus,
ToggleButton.sn-top-icon-btn:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.sn-top-icon {
    font-size: 16px;
    color: rgb(115, 115, 115);
}

.sn-top-icon-btn:hover .sn-top-icon,
.sn-top-icon-btn:focus .sn-top-icon {
    color: rgb(245, 245, 245);
}

/* Difficulty stepper — flat dark */
.sn-difficulty-stepper {
    flex-direction: row;
    align-items: center;
    background-color: rgb(22, 22, 22);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    height: 32px;
    min-height: 32px;
}

.unity-button.sn-stepper-arrow {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    color: rgb(82, 82, 82);
    padding: 0;
    margin: 0;
    width: 24px;
    height: 24px;
    min-height: 0;
    min-width: 0;
}

.unity-button.sn-stepper-arrow:hover,
.unity-button.sn-stepper-arrow:focus {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(245, 245, 245);
}

.unity-label.sn-stepper-label {
    color: rgb(245, 245, 245);
    font-size: 13px;
    margin: 0;
    padding-left: 6px;
    padding-right: 6px;
}

/* ── Shared overlays / panels ── */

.staticPanel {
    background-color: var(--sn-surface);
    border-color: var(--sn-border-2);
    border-width: 1px;
    border-radius: 6px;
}

/* ── Global dark background for all scenes ── */

#background {
    background-color: var(--sn-bg);
}

/* overlayBackground on a dark bg would be near-black — use surface instead */
.overlayBackground {
    background-color: var(--sn-surface);
}

/* ── Options / About / Credits scene shared chrome ── */

/* Header row in options/about scenes */
.optionsSceneTitleContainer {
    background-color: rgba(0, 0, 0, 0);
}

/* Left nav in options/about scenes */
.optionsOverviewButton,
ToggleButton.toggleButton {
    background-color: var(--sn-surface);
    border-color: var(--sn-border-2);
    color: var(--sn-text-2);
    border-width: 1px;
    border-radius: 6px;
    -unity-text-align: middle-left;
    margin-bottom: 3px;
}

.optionsOverviewButton:hover,
ToggleButton.toggleButton:hover {
    background-color: var(--sn-surface-3);
    border-color: var(--sn-border-3);
    color: var(--sn-text);
}

/* Active/selected toggle button */
.optionsOverviewButton.isOn,
.optionsOverviewButton:checked,
ToggleButton.toggleButton.isOn,
ToggleButton.toggleButton:checked {
    background-color: var(--sn-surface-3);
    border-color: var(--sn-accent);
    color: var(--sn-text);
}

/* ── Loading scene ── */

#loadingLabel {
    color: var(--sn-text);
}

/* ── Singing results scene ── */

#titleLabel {
    color: var(--sn-text);
}

#artistLabel {
    color: var(--sn-text-2);
}

/* ── ScrollViews ── */

.unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

/* ── Dialog / modal overlay ── */

.overlayDialog {
    background-color: rgb(18, 18, 18);
    border-color: var(--sn-border-3);
    border-width: 1px;
}

/* ── ToggleButton checked state badge ── */

.listItem {
    background-color: var(--sn-surface);
    border-color: var(--sn-border);
    border-width: 1px;
    border-radius: 6px;
}

/* ── SongSelect three-region layout ── */

.sn-main-column {
    flex-grow: 1;
    flex-direction: column;
    background-color: var(--sn-bg);
}

.sn-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 32px;
    padding-right: 32px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sn-border);
    flex-shrink: 0;
    background-color: var(--sn-bg);
}

.sn-content-scroll {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 24px;
    padding-bottom: 24px;
}

.sn-page-title-block {
    flex-direction: column;
    margin-bottom: 24px;
}

.sn-section-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 18px;
}

/* Featured "Tonight's mood" cards */
.sn-featured-section {
    flex-direction: column;
    margin-bottom: 32px;
}

.sn-featured-grid {
    flex-direction: row;
    flex-shrink: 0;
}

.sn-featured-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    align-items: stretch;
    height: auto;
    min-height: 0;
    flex-direction: column;
}

.sn-featured-card-last {
    margin-right: 0;
}

.sn-featured-art {
    height: 130px;
    width: 100%;
    border-radius: 4px;
    margin-bottom: 12px;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
    background-color: var(--sn-surface);
}

.unity-label.sn-featured-letter {
    font-size: 56px;
    -unity-font-style: italic;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    padding: 0;
}

.unity-label.sn-featured-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--sn-text);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
}

.unity-label.sn-featured-sub {
    font-size: 11px;
    color: var(--sn-text-3);
    margin-top: 2px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
}

/* Library list block */
.sn-library-block {
    flex-direction: column;
    flex-grow: 1;
}

.unity-label.sn-library-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--sn-text);
    margin: 0;
    padding: 0;
}

.unity-label.sn-library-count {
    font-size: 11px;
    color: var(--sn-text-3);
    letter-spacing: 1px;
    margin-left: 10px;
    padding: 0;
}

/* Persistent now-playing bar */
.sn-now-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 28px;
    padding-right: 28px;
    background-color: rgb(14, 14, 14);
    border-top-width: 1px;
    border-top-color: var(--sn-border);
    flex-shrink: 0;
}

.sn-now-info {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.sn-now-art {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    margin-right: 14px;
    background-color: var(--sn-surface-2);
    -unity-background-scale-mode: scale-and-crop;
}

.sn-now-text {
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

.unity-label.sn-now-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--sn-text);
    margin: 0;
    padding: 0;
}

.unity-label.sn-now-sub {
    font-size: 11px;
    color: var(--sn-text-3);
    margin-top: 1px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
}

.sn-now-actions {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.sn-difficulty-pill {
    flex-direction: row;
    align-items: center;
    background-color: var(--sn-surface-2);
    border-width: 1px;
    border-color: var(--sn-border-2);
    border-radius: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 14px;
}

.unity-label.sn-difficulty-label {
    font-size: 11px;
    color: var(--sn-text-4);
    letter-spacing: 2px;
    margin-right: 10px;
    padding: 0;
}

.unity-button.sn-sing-button {
    background-color: var(--sn-accent);
    border-color: var(--sn-accent);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    border-radius: 6px;
    padding-top: 9px;
    padding-right: 22px;
    padding-bottom: 9px;
    padding-left: 22px;
    margin: 0;
    height: auto;
    min-height: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.unity-button.sn-sing-button:hover,
.unity-button.sn-sing-button:focus {
    background-color: var(--sn-accent-hover);
    border-color: var(--sn-accent-hover);
}
