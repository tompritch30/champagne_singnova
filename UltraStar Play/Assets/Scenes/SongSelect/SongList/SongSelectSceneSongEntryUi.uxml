<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="songEntryUiRoot" class="sn-row-root" style="flex-direction: row; align-items: stretch; flex-grow: 1;">
        <!-- vinylImage kept for C# compat, hidden -->
        <ui:VisualElement name="vinylImage" style="display: none;" />
        <ui:VisualElement name="innerSongEntryUi" class="sn-song-row" style="flex-direction: row; align-items: center; flex-grow: 1; padding-left: 8px; padding-right: 12px; padding-top: 4px; padding-bottom: 4px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;">

            <!-- Cover art tile (40x40) — solid color block + letter, OR real cover when set by C# -->
            <ui:VisualElement name="songImageOuter" class="sn-row-art" style="width: 40px; height: 40px; min-width: 40px; min-height: 40px; flex-shrink: 0; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; align-items: flex-start; justify-content: flex-end; overflow: hidden; padding-left: 6px; padding-bottom: 4px;">
                <ui:VisualElement name="songImageInner" picking-mode="Ignore" class="overlay" style="-unity-background-scale-mode: scale-and-crop;" />
                <ui:Label name="songCoverLetter" class="sn-row-letter" picking-mode="Ignore" text="" style="font-size: 22px; -unity-font-style: italic; color: rgba(255, 255, 255, 0.85); margin: 0; padding: 0;" />
                <ui:VisualElement name="folderImage" picking-mode="Ignore" class="overlay" style="background-image: url(&quot;project://database/Packages/playshared/Runtime/Graphics/Icons/Folder.png?fileID=2800000&amp;guid=e71a978c024d44a4bb6a7702a64c1cd0&amp;type=3#Folder&quot;); -unity-background-scale-mode: scale-and-crop; display: none;">
                    <ui:VisualElement name="folderPreviewImage" picking-mode="Ignore" class="overlay" style="-unity-background-scale-mode: scale-and-crop;" />
                </ui:VisualElement>
                <MaterialIcon tabindex="-1" icon="cloud_off" name="notAvailableInOnlineGameIcon" class="overlay rounded" style="-unity-text-align: middle-center; font-size: 24px; display: none; color: rgb(245, 245, 245);" />
            </ui:VisualElement>

            <!-- Title + artist -->
            <ui:VisualElement name="songInfoContainer" picking-mode="Ignore" style="flex-grow: 1; flex-shrink: 1; flex-direction: column; margin-left: 12px; overflow: hidden;">
                <ui:Label text="Song Title" display-tooltip-when-elided="true" name="songTitle" picking-mode="Ignore" class="ellipsis" style="white-space: nowrap; -unity-font-style: bold; font-size: 13px; color: rgb(245, 245, 245);" />
                <ui:Label text="Artist Name" display-tooltip-when-elided="true" name="songArtist" picking-mode="Ignore" class="ellipsis" style="white-space: nowrap; font-size: 11px; color: rgb(115, 115, 115); margin-top: 1px;" />
            </ui:VisualElement>

            <!-- Right-side: stars + flags + menu -->
            <ui:VisualElement name="row" picking-mode="Ignore" style="flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 12px;">
                <ui:VisualElement name="stars" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-right: 10px;">
                    <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" style="font-size: 11px; color: rgb(82, 82, 82);" />
                    <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" style="font-size: 11px; color: rgb(82, 82, 82);" />
                    <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" style="font-size: 11px; color: rgb(82, 82, 82);" />
                    <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" style="font-size: 11px; color: rgb(82, 82, 82);" />
                    <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" style="font-size: 11px; color: rgb(82, 82, 82);" />
                </ui:VisualElement>
                <ui:VisualElement name="iconBar" picking-mode="Ignore" style="flex-direction: row; align-items: center; margin-right: 6px;">
                    <ui:VisualElement name="songEntryDuetIcon" picking-mode="Ignore" style="flex-shrink: 0; width: 14px; height: 14px; background-image: url(&quot;project://database/Assets/Common/Graphics/Icons/DuetIconWithOutline.png?fileID=2800000&amp;guid=0babf1c7d1bbb374d8d09884cc3a4e8a&amp;type=3#DuetIconWithOutline&quot;); -unity-background-scale-mode: scale-to-fit; display: none; margin-right: 4px;" />
                    <MaterialIcon name="songEntryFavoriteIcon" icon="favorite" picking-mode="Ignore" style="font-size: 12px; color: rgb(82, 82, 82); margin-right: 4px;" />
                    <MaterialIcon name="songEntryAutoGeneratedIcon" icon="auto_awesome" picking-mode="Ignore" style="font-size: 12px; color: rgb(82, 82, 82); margin-right: 4px;" />
                    <MaterialIcon name="songEntryRemoteSourceIcon" icon="cloud" picking-mode="Ignore" style="font-size: 12px; color: rgb(82, 82, 82);" />
                </ui:VisualElement>
                <ui:Button display-tooltip-when-elided="true" name="openSongMenuButton" class="squareButton transparentBackgroundColor focusableNavigatorIgnore" style="padding: 0; border-width: 0; width: 22px; height: 22px; min-height: 0; background-color: rgba(0, 0, 0, 0);">
                    <MaterialIcon tabindex="-1" picking-mode="Ignore" name="openSongMenuIcon" icon="more_vert" style="font-size: 16px; color: rgb(115, 115, 115);" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
