<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="background" class="sn-main-screen" style="flex-direction: column; justify-content: space-between; flex-grow: 1; background-color: rgb(10, 10, 10); padding-top: 40px; padding-right: 48px; padding-bottom: 40px; padding-left: 48px;">

        <!-- logo kept hidden for C# compatibility -->
        <ui:VisualElement name="logo" style="display: none;" />

        <!-- TOP BAR -->
        <ui:VisualElement class="sn-main-top" style="flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0;">
            <ui:Label class="sn-wordmark" text="SINGNOVA" />
            <ui:Label class="sn-eyebrow" text="KARAOKE" />
        </ui:VisualElement>

        <!-- BODY: left editorial + right CTA cards -->
        <ui:VisualElement class="sn-main-body" style="flex-direction: row; flex-grow: 1; align-items: flex-end; margin-top: 40px; margin-bottom: 40px;">

            <ui:VisualElement class="sn-main-left" style="flex-grow: 1; flex-shrink: 1; flex-basis: 1px; margin-right: 60px; flex-direction: column; justify-content: flex-end;">
                <ui:Label class="sn-eyebrow" text="WELCOME BACK" />
                <ui:Label class="sn-display" text="Sing&#10;something&#10;tonight." />
                <ui:Label class="sn-body-text" text="18,000+ songs. Starts in seconds." />
            </ui:VisualElement>

            <!-- name="row" kept for C# lookup; flex-direction: column overrides #row rule -->
            <ui:VisualElement name="row" class="sn-main-right" style="flex-direction: column; flex-grow: 0; flex-shrink: 0; width: 380px; max-width: 380px; justify-content: flex-end;">
                <ui:Button text="" name="startButton" class="sn-cta-primary">
                    <ui:VisualElement class="sn-cta-text">
                        <ui:Label class="sn-cta-title" text="Sing" />
                        <ui:Label class="sn-cta-sub" text="Solo or pass the mic  ·  1-4 players" />
                    </ui:VisualElement>
                    <ui:Label class="sn-cta-arrow" text="&#x2192;" />
                </ui:Button>
                <ui:Button text="" name="partyButton" class="sn-cta-secondary">
                    <ui:VisualElement class="sn-cta-text">
                        <ui:Label class="sn-cta-title" text="Tournament" />
                        <ui:Label class="sn-cta-sub" text="Bracket play  ·  4-16 players" />
                    </ui:VisualElement>
                    <ui:Label class="sn-cta-arrow" text="&#x2192;" />
                </ui:Button>
                <ui:Button text="" name="onlineGameButton" class="sn-cta-secondary">
                    <ui:VisualElement class="sn-cta-text">
                        <ui:Label class="sn-cta-title" text="Online" />
                        <ui:Label class="sn-cta-sub" text="Play with friends remotely" />
                    </ui:VisualElement>
                    <ui:Label class="sn-cta-arrow" text="&#x2192;" />
                </ui:Button>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- FOOTER -->
        <ui:VisualElement name="bottomButtonRow" class="sn-main-footer" style="flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0;">

            <ui:VisualElement class="sn-footer-links" style="flex-direction: row; align-items: center;">
                <ui:Button name="settingsButton" class="sn-footer-link focusableNavigatorIgnore" text="Settings">
                    <MaterialIcon name="settingsProblemHintIcon" icon="warning" class="settingsProblemHintIcon rounded warningFontColor" style="position: absolute; bottom: 100%; display: none;" />
                </ui:Button>
                <ui:Button name="aboutButton" class="sn-footer-link" text="About" />
                <ui:Button name="creditsButton" class="sn-footer-link" text="Credits" />
                <ui:Button name="supportTheProjectButton" class="sn-footer-link" text="Support" />
                <ui:Button name="createSongButton" class="sn-footer-link" text="Create" />
                <ui:Button name="quitButton" class="sn-footer-link" text="Quit" />
            </ui:VisualElement>

            <ui:Button name="versionInfoContainer" class="sn-version-btn transparentButton focusableNavigatorIgnore" style="overflow: visible; align-items: flex-start; width: auto; height: auto; flex-shrink: 0;">
                <ui:Label text="v0.0.0" name="semanticVersionLabel" class="sn-version" />
                <ui:VisualElement name="versionDetailsContainer" class="ignoreTheme" style="background-color: rgba(14, 14, 14, 0.95); bottom: 110%; position: absolute; display: none; align-items: flex-start; padding-top: 8px; padding-right: 12px; padding-bottom: 8px; padding-left: 12px; border-radius: 4px; border-width: 1px; border-color: rgb(31, 31, 31);">
                    <ui:Label text="Commit: abc1234" name="commitHashLabel" class="ignoreTheme" style="font-size: 11px; color: rgb(115, 115, 115);" />
                    <ui:Label text="Unity: 6000.x" name="unityVersionLabel" class="ignoreTheme" style="font-size: 11px; color: rgb(115, 115, 115);" />
                    <ui:Label text="Built: 20260428" name="buildTimeStampLabel" class="ignoreTheme" style="font-size: 11px; color: rgb(115, 115, 115);" />
                </ui:VisualElement>
            </ui:Button>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
